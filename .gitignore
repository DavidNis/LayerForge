# Python environment and tool caches
.venv/
.cache/
__pycache__/
.pytest_cache/
*.py[cod]

# Scratch space
tmp/

# Run logs (regenerated by every CLI run)
*.log

# Regenerable documentation build intermediates (docs/technical_optB/build_pdf.py);
# the source chapters, figures and final PDF stay tracked.
docs/technical_optB/build/

# Default output of `layerforge_l1 build` (tests rebuild it in a temp folder)
artifacts/layer_feasibility/

# Regenerable L0 command output. Only the small reference_regression.json report
# and the pre-refactor baseline are tracked; CAD, masks and previews are rebuilt by
# `stack-reference` / `stack-export` / `stack-preview`.
artifacts/l0_core_v1/reference_*/cad/
artifacts/l0_core_v1/reference_*/previews/
artifacts/l0_core_v1/reference_*/stack/
artifacts/l0_core_v1/reference_*/validation.json
artifacts/l0_core_v1/legacy_import_*/

# L1 held-out evaluation output: derived from images whose provenance is not
# recorded (private evaluation only). freeze.json (hashes) stays trackable.
artifacts/l1_eval_v1/*/

# L2 manual review runs on the held-out bear proposal (private evaluation output).
artifacts/l2_review_v1/

# L3 print-kit evaluation output (kits include private held-out/reference artwork).
artifacts/l3_print_kit_v1/
